# CLEP Gateway Environment Variables

# Required
PLANE_API_URL=http://plane.clep.svc.cluster.local:80
PLANE_API_KEY=your-plane-api-key
PLANE_WEBHOOK_SECRET=your-webhook-secret
DATABASE_URL=postgres://clep:password@postgres.clep.svc.cluster.local:5432/clep
NATS_URL=nats://nats.clep.svc.cluster.local:4222

# Optional
HERMES_ADAPTER_URL=http://hermes-adapter.clep.svc.cluster.local:8081
EVENT_STREAM=clep.events
RESPONSE_STREAM=clep.responses
LOG_LEVEL=info

# Gateway
PORT=8080
